<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<IsPublishable Condition="'$(CopyRA2Dll)' == 'False'">false</IsPublishable>
	</PropertyGroup>

	<!--
		The shared RA2 library supports both the fused World War III mechanics and the
		integrated RA2 game. AudioBagLoader reads audio from locally owned RA2 data.
		The retail map conversion command remains excluded; packaged maps are already converted.
	-->
	<ItemGroup>
		<Compile Remove="UtilityCommands/ImportRA2MapCommand.cs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\OpenRA.Game\OpenRA.Game.csproj">
			<Private>False</Private>
		</ProjectReference>
		<ProjectReference Include="..\OpenRA.Mods.Common\OpenRA.Mods.Common.csproj">
			<Private>False</Private>
		</ProjectReference>
		<ProjectReference Include="..\OpenRA.Mods.Cnc\OpenRA.Mods.Cnc.csproj">
			<Private>False</Private>
		</ProjectReference>
	</ItemGroup>
</Project>
